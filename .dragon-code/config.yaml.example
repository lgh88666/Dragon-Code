providers:
  - name: "Anthropic"
    protocol: "anthropic"
    api_key: "请填写你的 Anthropic API Key"
    model: "claude-sonnet-4-5"
    thinking: true
    # 可省略；Anthropic 默认使用 200000 Token 窗口。
    context_window: 200000
    # 可省略；省略时摘要复用主模型。
    summary_model: "你的轻量摘要模型名称"

  - name: "OpenAI Compatible"
    protocol: "openai"
    api_key: "请填写你的 OpenAI API Key"
    model: "gpt-5"
    # 接入兼容服务时填写；使用 OpenAI 官方端点时可删除本行。
    base_url: "https://api.openai.com/v1"
    # OpenAI Chat Completions 首版不会使用 thinking 配置。
    thinking: false
    # 可省略；OpenAI 及兼容端点默认使用 128000 Token 窗口。
    context_window: 128000
    # DeepSeek 兼容端点可填写 deepseek-v4-flash。
    summary_model: "你的轻量摘要模型名称"

# MCP Server 可以只配置 stdio，也可以同时配置多个 Server。
mcp_servers:
  local_test:
    type: "stdio"
    command: "uv"
    args: ["run", "python", "tests/fixtures/mcp_test_server.py"]

  # 远程 Streamable HTTP 示例。使用前取消注释，并在宿主环境设置 MCP_HTTP_TOKEN。
  # remote_demo:
  #   type: "http"
  #   url: "https://example.com/mcp"
  #   headers:
  #     Authorization: "Bearer ${MCP_HTTP_TOKEN}"
