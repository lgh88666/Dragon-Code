Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#banner {
    width: 1fr;
    height: auto;
    padding: 1 2 0 2;
    color: white;
}

#ready {
    width: 1fr;
    height: 1;
    margin: 0 2;
    color: $text-muted;
}

#conversation {
    width: 1fr;
    height: 1fr;
    margin: 1 2 0 2;
    scrollbar-size: 1 1;
}

#streaming {
    width: 1fr;
    height: auto;
    max-height: 40%;
    margin: 0 2;
    color: $text;
}

#timer {
    width: 1fr;
    height: 1;
    margin: 0 2;
    color: $warning;
}

#command-completion {
    width: 1fr;
    height: auto;
    max-height: 10;
    margin: 0 4;
    padding: 0 1;
    border: round $accent;
    background: $surface;
}

#input-row {
    width: 1fr;
    height: 5;
    margin: 0 2;
    border: round $accent;
}

#input-prompt {
    width: 3;
    height: 1fr;
    padding: 1 0 0 1;
    color: $accent;
    text-style: bold;
}

#message-input {
    width: 1fr;
    height: 1fr;
    border: none;
    background: transparent;
}

#statusbar {
    width: 1fr;
    height: 1;
    padding: 0 2;
    background: $primary-background;
    color: $text-muted;
}

#provider-name {
    width: 1fr;
}

#token-usage {
    width: auto;
    margin: 0 2;
}

#command-hint {
    width: auto;
    margin: 0 2;
    color: $text-muted;
}

#model-name {
    width: auto;
    text-align: right;
}

PermissionApprovalScreen {
    align: center middle;
    background: $background 70%;
}

#permission-dialog {
    width: 75%;
    max-width: 84;
    height: auto;
    max-height: 80%;
    border: round $warning;
    background: $surface;
    padding: 1 2;
}

#permission-title {
    width: 1fr;
    height: 2;
    color: $warning;
    text-style: bold;
}

#permission-summary {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    color: $text;
    text-style: bold;
}

#permission-reason {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
}

#permission-options {
    width: 1fr;
    height: auto;
    max-height: 8;
}

ProviderSelectScreen {
    align: center middle;
    background: $background 70%;
}

#provider-dialog {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 70%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#provider-title {
    width: 1fr;
    height: 2;
    text-style: bold;
}

#provider-options {
    width: 1fr;
    height: auto;
    max-height: 20;
}

SessionResumeScreen {
    align: center middle;
    background: $background 70%;
}

#resume-dialog {
    width: 82%;
    max-width: 96;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#resume-title {
    width: 1fr;
    height: 2;
    text-style: bold;
}

#resume-search {
    width: 1fr;
    margin-bottom: 1;
}

#resume-options {
    width: 1fr;
    height: auto;
    max-height: 20;
}

CommandHelpScreen,
SessionCommandScreen,
MemoryCommandScreen,
PermissionModeScreen,
ReviewTargetScreen,
SkillManagementScreen,
ConfirmCommandScreen {
    align: center middle;
    background: $background 70%;
}

#command-help-dialog,
#session-command-dialog,
#memory-command-dialog,
#permission-mode-dialog,
#review-target-dialog,
#skill-command-dialog,
#confirm-command-dialog {
    width: 84%;
    max-width: 100;
    height: auto;
    max-height: 84%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

.command-screen-title {
    width: 1fr;
    height: 2;
    text-style: bold;
}

.command-screen-hint {
    width: 1fr;
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

#command-help-body,
#memory-command-body,
#skill-command-body {
    width: 1fr;
    height: 18;
}

#command-help-options,
#memory-command-options,
#skill-command-options {
    width: 45%;
    height: 1fr;
}

#command-help-detail,
#memory-command-detail,
#skill-command-detail {
    width: 55%;
    height: 1fr;
    padding: 0 1;
    color: $text;
}

#session-command-search,
#review-target-input {
    width: 1fr;
    margin-bottom: 1;
}

#session-command-options,
#permission-mode-options,
#review-target-options,
#confirm-command-options {
    width: 1fr;
    height: auto;
    max-height: 20;
}

#confirm-command-target {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}
